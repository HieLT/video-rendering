n_info": [{"type": 1, "task_id": "", "duration_info": [{"step_name": "pre", "duration": 0}, {"step_name": "pre_prompt_review", "duration": 0}, {"step_name": "pre_prompt_attachment_review", "duration": 596}, {"step_name": "rag", "duration": 0}, {"step_name": "plan", "duration": 20019, "round_duration_info": [{"round": 1, "duration": 18333}, {"round": 2, "duration": 1686}]}, {"step_name": "fc", "duration": 2023, "round_duration_info": [{"round": 1, "duration": 2023}, {"round": 2, "duration": 0}]}, {"step_name": "simple_task", "duration": 0}, {"step_name": "total", "duration": 23443}], "error_code": 1}], "ai_creation_fallback_retry": "false", "ai_creation_layout_type": "mixed", "ai_creation_res_code": "710082031", "ai_creation_show_mode": "text", "ai_creation_tool_list": [], "attachment_scene": "4", "auto_create_creation": "1", "auto_create_creation_asset": "0", "before_content_type": "9999", "block_meta": {"items": ["txt"]}, "bot_state": {"bot_id": "7339470689562525703", "bot_name": "Dola", "agent_name": "Agent-Creation", "agent_id": "747548995167490123", "agent_psm": "flow.agent.creation"}, "brief": "肖像保護のため、Dreamina Seedance 2.5で生成できるのはあなた自身が写っている動画のみです。別の画像を使用するか、テキストから動画を作成してください。", "chat_ability": {"ability_type": 17, "ability_param": {"model": "seedance_v2.5", "duration": 30, "input_box_content": {"user_input_content": "=== REFERENCES ===\n\nUse the provided Riven, Broken Sword, forest environment,\nburning settlement environment, and starting-frame references.\n\nUse the references for visual continuity throughout the video.\n\nAt the beginning, Riven is already moving through the dark forest\ntoward the strong orange glow and smoke visible ahead.\n\nShe carries the Broken Sword with her.\n\nThe Broken Sword remains physically broken and dormant.\nNo glowing runes.\nNo magical energy.\n\nMaintain the established cinematic dark-fantasy atmosphere,\nenvironment, costume, and weapon design.\n\n\n=== TECHNICAL ===\n\n16:9 cinematic live-action dark fantasy.\n\nGrounded photorealistic realism.\n\nNatural human movement.\n\nNatural cinematic camera movement.\n\nClean cinematic cuts.\n\nDark evening forest illuminated by distant orange firelight.\n\nNatural wind, footsteps, fire, smoke, distant voices, and environmental sound.\n\nEnglish dialogue.\n\nNatural lip sync.\n\nNo subtitles.\n\nNo background music.\n\nKeep the staging simple and spatially clear.\n\nDo not reveal the mysterious dark figure.\n\nDo not show unusual dark markings yet.\n\n\n=== VIDEO SUMMARY ===\n\nRiven is already moving quickly through the forest toward the fire.\n\nShe reaches the final edge of the trees and slows down.\n\nA burning settlement is revealed ahead.\n\nPeople begin fleeing from the settlement toward the forest.\n\nSeveral soldiers are retreating with them.\n\nRiven remains near the road as they pass.\n\nShe asks one soldier what happened.\n\nHe only tells her to run and continues away.\n\nRiven watches everyone escaping.\n\nThen she looks toward the burning settlement.\n\nInstead of following them, she begins walking toward it alone.\n\n\n=== SHOTS ===\n\nShot 1 — REACHING THE FIRE\n\nBegin with Riven already moving quickly through the forest.\n\nDo not begin with a wide establishing shot.\n\nStart with a closer frontal tracking shot.\n\nThe camera moves backward in front of Riven as she moves forward.\n\nBehind her are dark pine trees,\nsmoke,\nand the strong orange glow of the distant fire.\n\nRiven is focused on what lies ahead.\n\nThe Broken Sword remains carried with her.\n\nCut naturally to a side tracking angle.\n\nRiven continues moving through the final section of forest.\n\nSmoke becomes thicker around the trees.\n\nOrange firelight begins reflecting across Riven,\nthe wet ground,\nand the surrounding forest.\n\nThe sound of fire becomes much stronger.\n\nRiven passes the final line of trees.\n\nShe suddenly slows down.\n\nHer attention locks onto something ahead.\n\nHold briefly on Riven.\n\nThen move the camera around her and reveal what she sees.\n\nA small settlement ahead is burning.\n\nMultiple wooden buildings are surrounded by fire and heavy smoke.\n\nThe settlement should feel close enough for Riven to enter,\nbut still separated from her by the final stretch of road.\n\nRiven silently watches.\n\n\nShot 2 — RUN\n\nMovement suddenly appears through the smoke.\n\nSeveral civilians emerge from the settlement.\n\nThey are running away from the fire\nand toward the forest.\n\nMore people follow.\n\nRiven remains beside the road as they pass her.\n\nThen several soldiers also emerge from the same direction.\n\nThey are retreating with the civilians.\n\nNobody is moving toward the settlement.\n\nEveryone is leaving it.\n\nOne soldier passes close to Riven.\n\nRiven turns toward him and asks:\n\n\"What happened?\"\n\nThe soldier briefly looks at her.\n\nHe looks back toward the burning settlement.\n\nThen he says:\n\n\"Just run!\"\n\nHe immediately continues toward the forest.\n\nThe other soldiers continue with him.\n\nRiven watches them leave.\n\nDo not explain what they are running from.\n\n\nShot 3 — THE WRONG DIRECTION\n\nRiven remains still as more civilians and soldiers move past her.\n\nKeep the camera relatively close.\n\nPeople continue moving away from the settlement on both sides of Riven.\n\nRiven slowly turns back toward the fire.\n\nHold on her looking into the burning settlement.\n\nShe briefly lowers her eyes toward the Broken Sword she carries.\n\nThe sword remains completely dormant.\n\nNo glow.\n\nNo magical reaction.\n\nRiven looks forward again.\n\nA short silence.\n\nThen she begins walking.\n\nBut she does not follow the others.\n\nRiven walks toward the burning settlement.\n\nMove the camera backward in front of Riven as she advances.\n\nRiven remains calm and focused in the center of the frame.\n\nCivilians and soldiers continue passing on both sides of her,\nmoving in the opposite direction.\n\nKeep the visual direction very clear:\n\neveryone else is moving OUT.\n\nRiven is moving IN.\n\nAs Riven gets closer,\nthe orange firelight becomes stronger\nand smoke begins surrounding the road.\n\nGradually allow the crowd to become smaller behind her.\n\nRiven continues forward alone.\n\nFinish with a wider cinematic composition:\n\nRiven walking toward the burning settlement,\n\nthe last civilians and soldiers retreating past her,\n\nheavy smoke moving between the buildings,\n\nand the fire illuminating the road ahead.\n\nRiven continues into the smoke.\n\nCUT.", "reply_message_format": "生成された動画：%s"}}}, "chat_history_count": "2", "chat_id": "1518931013392401", "chat_next": "1", "client_report_scene": "gui", "commerce_feature_key": "doubao_create_pe", "cot_switch": "0", "disable_action_view": "true", "finish_reason_chat": "succeed:completion", "finish_time_ms": "1790587274865", "force_submit_review": "1", "gen_msg_id": "1520515837797649", "general_task_param": {"runtime_type": 0, "need_modify_conversation": false, "agent_task_param": {}, "project_id": "", "agent_task_param_change": {"runtime_changed": false, "device_changed": false, "sandbox_auth_type_changed": false}}, "image_attachment_num": "4", "include_creation_material": "0", "inner_app_id": "495671", "inner_bot_id": "7339470689562525703", "inner_cluster": "default", "inner_did": "7690510486792455685", "inner_env": "prod", "inner_flow_app_variant": "doubao", "inner_is_dola_agent_hub": "1", "inner_is_tour": "false", "inner_libra_versions": "72202937,72143374,73582984,76233209,76915148,76999789,77046910,77046923,77068989,77069090,77088724,71795104,72061060,72168304,76461562,76709907,77202863,76295624,76961156,77088589,77231336", "inner_log_id": "20260928172050869C28558D8DDB471529", "inner_msg_lang_code": "en", "inner_msg_lang_confidence": "0.9971204400062561", "inner_msg_lang_display_code": "en", "inner_msg_lang_exemption": "false", "inner_pc_version": "3.38.0", "inner_platform": "web", "inner_real_app_id": "495671", "inner_region": "VN", "inner_samantha_web": "true", "inner_t